# Local (mặc định). Không dùng file này trên Render.
SPRING_PROFILES_ACTIVE=local

# --- Production (Render + Aiven MySQL) ---
# SPRING_PROFILES_ACTIVE=prod
# SERVER không cần đặt PORT: Render tự inject PORT.
#
# Lấy Host, Port, User, Password, Database từ Aiven → Overview.
# Bắt buộc sslMode=REQUIRED. Không dùng useSSL=false.
# SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&tcpKeepAlive=true
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=mat_khau_aiven
#
# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự. Đổi là mọi phiên đăng nhập cũ hết hạn.
# JWT_SIGNER_KEY=
# JWT_ACCESS_EXPIRATION_MS=7776000000
# JWT_REFRESH_EXPIRATION_MS=7776000000
#
# Origin Vercel, không có dấu / cuối. Nhiều origin cách nhau bằng dấu phẩy.
# CORS_ALLOWED_ORIGINS=https://ten-app.vercel.app
# Tùy chọn, cho phép URL preview của Vercel:
# CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app
# APP_FRONTEND_URL=https://ten-app.vercel.app
# FRONTEND_RESET_PASSWORD_URL=https://ten-app.vercel.app/auth/reset-password
#
# Tạo admin lần đầu. Xóa APP_ADMIN_PASSWORD sau khi đăng nhập được.
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=doi-thanh-mat-khau-dai
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_FULL_NAME=Quản trị hệ thống
#
# Chưa có SMTP thì để false.
# APP_MAIL_ENABLED=false

SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

JWT_SIGNER_KEY=change-me-in-production-min-32-characters-long!!
JWT_ACCESS_EXPIRATION_MS=7776000000
JWT_REFRESH_EXPIRATION_MS=7776000000

CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password
MAIL_FROM=noreply@qlhs.local
APP_MAIL_ENABLED=false
